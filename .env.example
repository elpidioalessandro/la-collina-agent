# Un solo file per tutti i servizi: copialo in .env (cp .env.example .env) e inserisci la chiave.
# Chiave gratuita: https://console.groq.com/keys
GROQ_API_KEY=la_tua_chiave_groq

# Due modelli diversi perché sul piano gratuito di Groq il limite di token al minuto vale per modello.
ORCHESTRATOR_MODEL=openai/gpt-oss-120b
DATA_AGENT_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_REASONING_EFFORT=low

# Porte dei servizi (il front end è sempre su 5173)
DATA_AGENT_PORT=8000
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:5173

# Log dell'agente dati: "testo" (chiave=valore) o "json"; livello DEBUG, INFO, WARNING
LOG_FORMAT=testo
LOG_LEVEL=INFO

# I grafici PNG più vecchi di così vengono cancellati
GRAFICI_MAX_ORE=24
